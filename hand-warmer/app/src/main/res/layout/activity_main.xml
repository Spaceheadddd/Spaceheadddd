<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.35"
                android:text="IGNIS"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@color/dim" />

            <TextView
                android:id="@+id/stateTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:text="IDLE"
                android:textColor="@color/dim"
                android:textSize="11sp" />
        </LinearLayout>

        <com.spacehead.handwarmer.ui.ThermalGaugeView
            android:id="@+id/gauge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.1"
            android:text="STANDBY"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <!-- Telemetry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:id="@+id/row3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Tap ROOM to calibrate against a real thermometer · tap OUTSIDE to refresh"
                android:textColor="@color/dim"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Battery drain summary (details on the Battery screen) -->
        <LinearLayout
            android:id="@+id/drainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.25"
                    android:text="BATTERY DRAIN"
                    android:textColor="@color/dim"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.2"
                    android:text="DETAILS ›"
                    android:textColor="@color/heat"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/drainRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Heat monitor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.25"
                    android:text="HEAT MONITOR // 12 MIN"
                    android:textColor="@color/dim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/exportLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip"
                    android:letterSpacing="0.2"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:text="EXPORT LOG"
                    android:textColor="@color/heat"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.spacehead.handwarmer.ui.HeatGraphView
                android:id="@+id/graph"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:text="MODE"
                android:textColor="@color/dim"
                android:textSize="10sp" />

            <LinearLayout
                android:id="@+id/presetRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/targetLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.15"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/targetSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:progressBackgroundTint="@color/line"
                android:progressTint="@color/heat"
                android:thumbTint="@color/heat" />

            <TextView
                android:id="@+id/timerLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.15"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/timerSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:progressBackgroundTint="@color/line"
                android:progressTint="@color/heat"
                android:thumbTint="@color/heat" />

            <Switch
                android:id="@+id/turbo"
                style="@style/HwSwitch"
                android:layout_marginTop="16dp"
                android:text="TURBO" />

            <TextView
                style="@style/HwHint"
                android:text="Also loads the graphics chip: fastest warm-up, more battery drain" />

            <Switch
                android:id="@+id/stayAwake"
                style="@style/HwSwitch"
                android:layout_marginTop="12dp"
                android:text="STAY AWAKE" />

            <TextView
                style="@style/HwHint"
                android:text="Keeps the screen on while the app is open. One UI limits background CPU when the screen is off, which can stall heating." />

            <Switch
                android:id="@+id/screenBoost"
                style="@style/HwSwitch"
                android:layout_marginTop="12dp"
                android:text="SCREEN BOOST" />

            <TextView
                style="@style/HwHint"
                android:text="Full brightness + screen on while the app is open" />

            <Switch
                android:id="@+id/overdrive"
                style="@style/HwSwitch"
                android:layout_marginTop="12dp"
                android:text="⚠ OVERDRIVE"
                android:textColor="@color/danger"
                android:thumbTint="@color/danger" />

            <TextView
                style="@style/HwHint"
                android:text="Unlocks 45–46 °C · 20 min sessions · resets when the app closes" />
        </LinearLayout>

        <TextView
            android:id="@+id/toggleButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_primary"
            android:gravity="center"
            android:letterSpacing="0.4"
            android:text="IGNITE"
            android:textColor="@color/bg"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:id="@+id/interlocks"
            android:textColor="@color/dim"
            android:textSize="9sp" />

        <!-- Arcane Labs signature -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:background="@color/heat" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:letterSpacing="0.5"
                android:text="ARCANE LABS"
                android:textColor="@color/sig"
                android:textSize="12sp" />

            <View
                android:layout_width="28dp"
                android:layout_height="1dp"
                android:background="@color/heat" />
        </LinearLayout>

        <TextView
            android:id="@+id/buildTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:textColor="@color/dim"
            android:textSize="9sp" />
    </LinearLayout>
</ScrollView>
