<resources>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/heat</item>
        <item name="android:colorPrimary">@color/heat</item>
        <item name="android:colorControlActivated">@color/heat</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:fontFamily">monospace</item>
        <!-- Make the system splash a blank dark frame so our Arcane Labs loader is the real splash. -->
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/blank</item>
    </style>
</resources>
